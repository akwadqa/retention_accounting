 "html": "{% if letter_head %}\n    <div style=\"margin: 0 0 20px 0;\">{{ letter_head }}</div>\n{% endif %}\n\n<h1 class=\"text-center\" style=\"width: 100%; padding: 10px 0; margin: 0 auto 20px; font-weight: bold;\">RECEIPT VOUCHER</h1>\n\n<div style=\"display: flex; justify-content: space-between; align-items: center;\">\n    <div>\n        <div>\n            <span style=\"font-weight: bold; letter-spacing: 0.5px;\">VOUCHER NUMBER: </span><span>{{ doc.name }}</span>\n        </div>\n        <div>\n            <span style=\"font-weight: bold; letter-spacing: 0.5px;\">PAID TO: </span><span>{{ doc.party_name }}</span>\n        </div>\n        <div>\n            <span style=\"font-weight: bold; letter-spacing: 0.5px;\">PAYMENT TYPE: </span><span>{{ doc.mode_of_payment }}</span>\n        </div>\n        <div>\n            <span style=\"font-weight: bold; letter-spacing: 0.5px;\">DATE OF PAYMENT: </span><span>{{ doc.posting_date }}</span>\n        </div>\n    </div>\n    \n    <table style=\"font-size: 14px; border: 2px solid black; display: inline-block; width: 200px;\">\n        <thead>\n            <tr>\n                <th style=\"color: black; font-weight: bold; text-align: center; border-bottom: 1px dashed black; width: 200px;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td style=\"font-weight: bold; text-align: center; width: 200px;\">QRS. {{ '{:,.2f}'.format(doc.paid_amount) }}</td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n<table style=\"margin-top: 20px; font-size: 14px; border: 2px solid black; width: 100%;\">\n    <thead>\n        <tr>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Due Date</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Cheque Number</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Account Name</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Account Number</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Debit Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td style=\"border: 1px dashed black;\">{{ doc.reference_date }}</td>\n            <td style=\"border: 1px dashed black;\">{{ doc.reference_no }}</td>\n            <td style=\"border: 1px dashed black;\">{{ doc.paid_to }}</td>\n            <td style=\"border: 1px dashed black;\">{{ frappe.db.get_value(\"Account\", doc.paid_to, \"account_number\") }}</td>\n            <td style=\"border: 1px dashed black;\">{{ '{:,.2f}'.format(doc.total_allocated_amount) }}</td>\n        </tr>\n        <tr>\n            <td colspan=\"5\" style=\"border: 1px dashed black;\">{{ doc.remarks }}</td>\n        </tr>\n        <tr>\n            <td colspan=\"5\" style=\"border: 1px dashed black;\">{{ doc.in_words }}</td>\n        </tr>\n    </tbody>\n</table>\n\n<table style=\"margin-top: 20px; font-size: 14px; border: 2px solid black; width: 100%;\">\n    <thead>\n        <tr>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Due Date</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Cheque Number</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black;\">Bank</th>\n            <th style=\"color: black; font-weight: bold; border: 1px dashed black; width: 200px;\">Received By</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td style=\"border: 1px dashed black;\">{{ doc.reference_date }}</td>\n            <td style=\"border: 1px dashed black;\">{{ doc.reference_no }}</td>\n            <td style=\"border: 1px dashed black;\">{{ doc.paid_from }}</td>\n            <td style=\"border: 1px dashed black; width: 200px;\">Name:<br>QID:<br>Signature:</td>\n        </tr>\n    </tbody>\n</table>\n\n\t<table style=\"width: 100%; font-size: 14px; font-weight: bold; margin-top: 80px;\">\n\t\t<tbody>\n\t\t\t<tr>\n\t\t\t\t<td style=\"text-align: center;\">Prepared By</td>\n\t\t\t\t<td style=\"text-align: center;\">Checked By</td>\n\t\t\t\t<td style=\"text-align: center;\">Approved By</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>",
